# VLM 偵測（src/llm_detect.py）需要的環境變數。
# 程式不讀 .env 檔：請設成系統或使用者環境變數（Windows：「編輯您帳戶的環境變數」）。
# 金鑰不要寫進程式或提交到 git。

# Azure OpenAI（GPT）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<資源名稱>.openai.azure.com/
# 部署名稱（選填，未設定時為 gpt-5.6-sol）
AZURE_OPENAI_DEPLOYMENT=

# Google Gemini
GEMINI_API_KEY=

# Claude（Azure AI Foundry）
ANTHROPIC_API_KEY=
CLAUDE_ENDPOINT=https://<資源名稱>.services.ai.azure.com/
